#!/bin/sh
# Virtual host do site institucional. A lista vem de GALLOSOUND_PUBLIC_HOSTS
# (hosts separados por virgula). Vazio: nenhum vhost extra; o default segue
# servindo /gallosoundsite/ no host da plataforma.
set -eu

site="gallosound"
available="/etc/apache2/sites-available/${site}.conf"
enabled="/etc/apache2/sites-enabled/${site}.conf"

rm -f "$available" "$enabled"

raw=$(printf '%s' "${GALLOSOUND_PUBLIC_HOSTS:-}" | tr '[:upper:]' '[:lower:]' | tr ',' ' ')
hosts=""
for token in $raw; do
    if ! printf '%s' "$token" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'; then
        echo "GALLOSOUND_PUBLIC_HOSTS: host invalido: ${token}" >&2
        exit 1
    fi
    case " ${hosts} " in
        *" ${token} "*) ;;
        *) hosts="${hosts} ${token}" ;;
    esac
done

hosts=$(printf '%s' "$hosts" | awk '{$1=$1; print}')
if [ -z "$hosts" ]; then
    exit 0
fi

# shellcheck disable=SC2086
set -- $hosts
server_name="$1"
shift
aliases="$*"

{
    echo '<VirtualHost *:80>'
    echo "    ServerName ${server_name}"
    if [ -n "$aliases" ]; then
        echo "    ServerAlias ${aliases}"
    fi
    echo '    DocumentRoot /var/www/html/gallosoundsite'
    echo ''
    echo '    # Este host so publica o site. Os apps continuam no vhost default.'
    echo '    RedirectMatch 403 "(?i)(^|/)(\\.git|\\.cursor|\\.svn|\\.hg|secure-data)(/|$)"'
    echo '    RedirectMatch 403 "(?i)(^|/)(\\.env([^/]*)?|credentials\\.json|token[^/]*\\.json|sftp-config\\.json|config[^/]*\\.(php|json)|environment\\.php|composer\\.(json|lock)|[^/]*\\.(sql|dump|bak|backup|old|orig|save)(\\.[^/]*)?|[^/]*~)$"'
    echo ''
    echo '    DirectoryIndex index.php'
    echo ''
    echo '    <Directory /var/www/html/gallosoundsite>'
    echo '        Options FollowSymLinks'
    echo '        AllowOverride All'
    echo '        Require all granted'
    echo ''
    echo '        <FilesMatch "(^\\.|^Config(\\.php|_exemple\\.php)$|^sftp-config\\.json$|\\.sql$|\\.bak$|\\.env$|\\.ini$|\\.log$)">'
    echo '            Require all denied'
    echo '        </FilesMatch>'
    echo '    </Directory>'
    echo ''
    echo '    ErrorLog ${APACHE_LOG_DIR}/error.log'
    echo '    CustomLog ${APACHE_LOG_DIR}/access.log combined'
    echo '</VirtualHost>'
} > "$available"

a2ensite "$site" >/dev/null
apache2ctl -t
