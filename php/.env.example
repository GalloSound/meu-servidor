PHP_VERSION=8.2
PHP_RUNTIME_PORT=8082

DOCKER_NETWORK=rede-banco-global

APP_ENV=development
PATH_SISTEMA=/var/www/html/app_sistema

DB_DRIVER=mysql
DB_HOST=mariadb_global
DB_DATABASE=gpsjundi_bdgsfacil
DB_USER=root
# Mesma senha do MariaDB em infra/ (MARIADB_ROOT_PASSWORD)
DB_PASS=__REQUIRED__
API_SECRET_KEY=__REQUIRED__

# Local
APP_BASE_URL_APP=http://localhost:8082/app/
APP_BASE_URL_APP_NF=http://localhost:8082/app_nf/
APP_BASE_URL=http://localhost:8082/app_sistema/
APP_BASE_URL_NEW=http://localhost:8082/gsfacilfront/public/
APP_BASE_URL_PEOPLECONTACTS=http://localhost:8082/peoplecontacts/
APP_BASE_URL_GALLOSOUNDSITE=http://localhost:8082/gallosoundsite/

# Rotas e APIs consumidas pelo gsfacilFront
BASE_DIR=/gsfacilfront/public
BASE_URL_IMAGES=/app_sistema/
BASE_APP=/app/
# Browser não chama a API Node. O gsfacilFront usa /internal/api (sessão+CSRF).
# PHP → Node na rede Docker:
INTERNAL_API_URL=http://apigsfacil:4000
INTERNAL_API_SECRET=__REQUIRED__
INTERNAL_API_TIMEOUT=20
# Legado (não injetar no JavaScript). Manter vazio após o rollout do proxy.
BASE_API_GSFACIL=
BASE_API_RASTREIO=
BASE_URL_API_CONTACTS=/gcar/
BASE_URL_API_PEOPLECONTACTS=/apicontacts/

# Google Calendar / Contacts
# Em APP_ENV=development o runtime sobe sem estas chaves.
# Em APP_ENV=production o entrypoint recusa startup se alguma estiver vazia.
# Calendar/Contacts no Mac sem OAuth respondem 500 ao chamar /gcar e /apicontacts.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_TOKEN_PATH=
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
GOOGLE_CONTACTS_REFRESH_TOKEN=
# Opcionais: usados somente pelo quickstart.php legado
GOOGLE_CONTACTS_REDIRECT_URI=
GOOGLE_CONTACTS_TOKEN_PATH=
