MARIADB_ROOT_PASSWORD=__REQUIRED__
MARIADB_DATABASE=gpsjundi_bdgsfacil

PHPMYADMIN_PORT=8080
FILEBROWSER_PORT=8083

# Deve ser o mesmo nome usado nas stacks PHP/Node
DOCKER_NETWORK=rede-banco-global
# Nome canonico da rede proxy (PHP/Node/NPM). A infra nao cria esta rede:
# crie com `docker network create` conforme docs/hardening-privilegio-redes.md.
DOCKER_PROXY_NETWORK=rede-proxy-global

# Linux VPS: ajuste para o usuario/grupo corretos (ex.: 1000/1000)
FILEBROWSER_PUID=501
FILEBROWSER_PGID=20
