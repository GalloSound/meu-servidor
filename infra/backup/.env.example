TZ=America/Sao_Paulo
KOPIA_IMAGE_TAG=0.23.1
RCLONE_IMAGE_TAG=1.69
KOPIA_UI_PORT=51515
KOPIA_UI_USER=admin
# Estas duas senhas alimentam somente render-kopia-secrets.sh.
# O container le arquivos em secrets/, nao estes valores na linha de comando.
KOPIA_UI_PASSWORD=__REQUIRED__
KOPIA_REPOSITORY_PASSWORD=__REQUIRED__
KOPIA_REPOSITORY_PASSWORD_FILE=./secrets/kopia-repository-password
KOPIA_UI_HTPASSWD_FILE=./secrets/kopia-ui.htpasswd
KOPIA_SYSTEM_USER=backup

MARIADB_CONTAINER=mariadb_global
MARIADB_DATABASE=gpsjundi_bdgsfacil
NPM_DB_CONTAINER=npm_db

# Banco principal: sempre obrigatorio (sobe container se parado)
BACKUP_DB_START_CONTAINERS=true
BACKUP_DB_MIN_BYTES=1024
BACKUP_NPM_DB_ENABLED=true
BACKUP_NPM_DB_REQUIRED=false

RCLONE_CONFIG=/rclone/rclone.conf
KOPIA_RCLONE_EXE=/usr/bin/rclone
RCLONE_REMOTE_NAME=gdrive
RCLONE_REMOTE_PATH=Backup_meu_servidor_Docker/Backup_teste_Mac

# Full backup (clone de arquivos) alem dos dumps SQL/configs
BACKUP_FULL_ENABLED=true
BACKUP_FULL_FAIL_SOFT=true
BACKUP_FULL_TARGET_NAME=full
BACKUP_FULL_SOURCES=php,node,infra,docs,README.md
BACKUP_FULL_EXCLUDES=.git/,.DS_Store,infra/data/,infra/filebrowser/database/,infra/filebrowser/config/,infra/nginx-proxy-manager/data/,infra/backup/data/,infra/backup/staging/,infra/backup/rclone/,infra/backup/credentials/,infra/backup/secrets/,php/*/vendor/,node/*/node_modules/

# Staging local depois do snapshot confirmado. Padrao: so lista, nao apaga.
# BACKUP_STAGING_KEEP aceita 2 ou 3.
BACKUP_STAGING_KEEP=3
BACKUP_STAGING_CLEANUP=false
